# mikevideo-cloud config. Copy to .env and fill secrets (never commit .env).

PORT=8090

# Media + shared ingest volume.
DATA_ROOT=/data/mikevideo
INGEST_DATA_ROOT=/data/mikevideo/ingest

# Postgres (own container). POSTGRES_PASSWORD is used by both compose services;
# DATABASE_URL is derived in docker-compose.yml.
POSTGRES_PASSWORD=change-me-long-random

# MUST match mikevideo-ingest's .env INGEST_HMAC_SECRET (cloud mints tickets ingest trusts).
INGEST_HMAC_SECRET=change-me-must-match-ingest

# MUST match mikevideo-ingest's .env CALLBACK_SECRET (ingest signs its callback with it).
CALLBACK_SECRET=change-me-must-match-ingest

# Public ingest URL the browser/app uploads chunks to.
INGEST_URL=https://up.osmike.com

# IdP for X-API-KEY -> user_id (legacy path).
MIKEOSCOMPUTERS_URL=https://mikeoscomputers-production.up.railway.app

# OAuth 2.0 resource server (account.osmike.com). Validate RS256 Bearer JWTs
# locally via JWKS — no secrets, public keys only. Defaults are correct.
ACCOUNT_OSMIKE_ISSUER=https://account.osmike.com
OAUTH_AUDIENCE=mikevideo

# Per-user storage quota (bytes). 100 GB.
USER_QUOTA_BYTES=107374182400

# Ticket lifetime (seconds) and max accepted upload (bytes, 20 GB matches ingest).
TICKET_TTL_SECONDS=21600
MAX_UPLOAD_BYTES=21474836480

# --- Speech → text (docs/SPEECH-PIPELINE.md) ---
# Quality-first, CPU-only, background. Defaults are good; override only to tune.
ASR_ENABLED=true
ASR_MODEL=large-v3
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=5
# Cap CPU threads so transcription stays gentle on the shared box (OSM stack).
ASR_CPU_THREADS=4
ASR_MODEL_CACHE=/data/mikevideo/models
# Force a language (e.g. en) or leave empty to auto-detect (LID folded into ASR).
ASR_LANGUAGE=

# --- Phase C: AI enrichment via the free GPU brain (qwen3) ---
# Fleet-wide GPU URL carrying host+port+creds. Empty ⇒ enrichment stays dormant
# (videos sit at enrich_status=pending and enrich once this is set + restarted).
#   ollama://<user>:<pass>@81.8.177.182:11443
OLLAMA_GPU_URL=
OLLAMA_GPU_MODEL=qwen3:8b
ENRICH_ENABLED=true
