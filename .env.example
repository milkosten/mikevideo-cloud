# mikevideo-cloud config. Copy to .env and fill secrets (never commit .env).

PORT=8090

# Media + shared ingest volume.
DATA_ROOT=/data/mikevideo
INGEST_DATA_ROOT=/data/mikevideo/ingest

# Postgres (own container). POSTGRES_PASSWORD is used by both compose services;
# DATABASE_URL is derived in docker-compose.yml.
POSTGRES_PASSWORD=change-me-long-random

# MUST match mikevideo-ingest's .env INGEST_HMAC_SECRET (cloud mints tickets ingest trusts).
INGEST_HMAC_SECRET=change-me-must-match-ingest

# MUST match mikevideo-ingest's .env CALLBACK_SECRET (ingest signs its callback with it).
CALLBACK_SECRET=change-me-must-match-ingest

# Public ingest URL the browser/app uploads chunks to.
INGEST_URL=https://up.osmike.com

# IdP for X-API-KEY -> user_id.
MIKEOSCOMPUTERS_URL=https://mikeoscomputers-production.up.railway.app

# Per-user storage quota (bytes). 100 GB.
USER_QUOTA_BYTES=107374182400

# Ticket lifetime (seconds) and max accepted upload (bytes, 20 GB matches ingest).
TICKET_TTL_SECONDS=21600
MAX_UPLOAD_BYTES=21474836480
